{
  "permissions": {
    "allow": [
      "Bash(python check_health.py)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./assistant.db)",
      "Read(./chroma_data/**)",
      "Read(./uploads/**)",
      "Bash(python test_gemini.py)",
      "Bash(python test_multimodal.py)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/guard_invariants.py" }
        ]
      }
    ]
  }
}
